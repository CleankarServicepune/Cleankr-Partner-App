rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Role-Based Access Control
    function isAuthenticated() {
      return request.auth != null;
    }

    function isPartner() {
      return isAuthenticated() && (
        request.auth.token.role == 'partner' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'partner'
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow update: if isAuthenticated() && isOwner(userId)
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin']));
      allow write: if isAdmin();
    }

    // 2. Partners collection: Partner can only read & update own profile
    match /partners/{partnerId} {
      allow read: if isAuthenticated() && (isOwner(partnerId) || isAdmin());
      allow update: if isAuthenticated() && isOwner(partnerId)
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['tier', 'rating', 'totalJobsCompleted', 'kycStatus', 'isVerified']));
      allow write: if isAdmin();
    }

    // 3. Customers collection: Partners CANNOT access customer collection directly
    match /customers/{customerId} {
      allow read, write: if isAdmin();
      allow read: if isAuthenticated() && isOwner(customerId);
    }

    // 4. Services catalog: Public/read-only for Partners; Admin can modify prices
    match /services/{serviceId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 5. Bookings collection: Partner can ONLY read assigned bookings and update status
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.partnerId == request.auth.uid ||
        resource.data.customerId == request.auth.uid ||
        isAdmin()
      );

      // Partner can update ONLY valid job lifecycle states:
      // ACCEPTED -> ON_THE_WAY -> ARRIVED -> STARTED -> COMPLETED
      // Partner CANNOT change companyPrice, estimatedEarnings, customerId, partnerId, paymentStatus
      allow update: if isAuthenticated() && isPartner() && resource.data.partnerId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'beforePhotos', 'afterPhotos', 'cancellationReason', 'rescheduledDate'])
                    && request.resource.data.status in ['ACCEPTED', 'ON_THE_WAY', 'ARRIVED', 'STARTED', 'COMPLETED', 'CANCELLED'];

      allow create, delete: if isAdmin();
    }

    // 6. Service Changes: Partner can PROPOSE changes (status must be PENDING_APPROVAL).
    // Partner CANNOT approve own change or modify official companyPrice.
    match /service_changes/{changeId} {
      allow read: if isAuthenticated() && (
        resource.data.partnerId == request.auth.uid ||
        isAdmin()
      );

      allow create: if isAuthenticated() && isPartner()
                    && request.resource.data.partnerId == request.auth.uid
                    && request.resource.data.status == 'PENDING_APPROVAL';

      // Only Admin can approve/reject and modify status or adminRemark
      allow update, delete: if isAdmin();
    }

    // 7. Payments & Transactions: Read-only for Partner (own earnings); write is Admin/backend only
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.partnerId == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // 8. Notifications: Partner can read and mark own notifications as read
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && resource.data.recipientId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow create, delete: if isAdmin();
    }

    // 9. Earnings: Partner can view own summary; updates by Admin/Cloud Functions
    match /earnings/{partnerId} {
      allow read: if isAuthenticated() && (isOwner(partnerId) || isAdmin());
      allow write: if isAdmin();
    }

    // 10. Support Tickets & Account Deletion: Partner can create support/deletion request
    match /support_tickets/{ticketId} {
      allow read: if isAuthenticated() && (resource.data.partnerId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.partnerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
