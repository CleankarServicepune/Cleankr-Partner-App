<?xml version="1.0" encoding="utf-8"?>
<!--
   Production Network Security Configuration for Cleankr Partner App.
   Enforces strict HTTPS TLS 1.2+ communication across all endpoints.
   Cleartext HTTP traffic is completely disabled.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
