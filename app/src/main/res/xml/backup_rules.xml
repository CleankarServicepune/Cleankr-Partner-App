<?xml version="1.0" encoding="utf-8"?>
<!--
   Production Backup Rules for legacy API levels.
   Excludes shared preferences and database files from auto-backup to protect
   partner credentials and local session data.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="database" path="."/>
</full-backup-content>
