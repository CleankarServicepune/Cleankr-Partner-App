rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isPartner() {
      return isAuthenticated();
    }

    // Partner Job verification photos (Before / After service proof)
    match /jobs/{bookingId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isPartner()
                   && request.resource.size < 10 * 1024 * 1024 // max 10MB
                   && request.resource.contentType.matches('image/.*');
    }

    // Partner KYC documents (Encrypted in transit & at rest)
    match /partners/{partnerId}/kyc/{allPaths=**} {
      allow read: if isAuthenticated() && request.auth.uid == partnerId;
      allow write: if isAuthenticated() && request.auth.uid == partnerId
                   && request.resource.size < 5 * 1024 * 1024;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
